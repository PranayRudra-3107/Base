OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ENVIRONMENT=local
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000,http://127.0.0.1:3000
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional LangGraph/LangChain observability. Tracing turns on when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local

METADATA_BACKEND=local
DOCUMENT_STORAGE_BACKEND=local
VECTOR_BACKEND=chroma
DATABASE_URL=
S3_BUCKET=
S3_PREFIX=base
AWS_REGION=us-east-1
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MODEL=gpt-4o-mini
WEB_SEARCH_TOOL=web_search
WEB_SEARCH_CONTEXT_SIZE=medium
WEB_SEARCH_MIN_RELEVANCE=0.2
CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data
DOCUMENT_STORAGE_DIR=./data/documents
AUDIT_LOG_PATH=./data/audit_log.jsonl
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=5
PUBLIC_APP_URL=
CONNECTOR_SYNC_LIMIT=50
CONNECTOR_TIMEOUT_SECONDS=25

# Optional OAuth apps for live connector sign-in.
# Keep real values in backend/.env locally or AWS Secrets Manager in production.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=
MICROSOFT_CONNECTOR_SCOPES=offline_access User.Read Mail.Read Team.ReadBasic.All Channel.ReadBasic.All ChannelMessage.Read.All Chat.Read Sites.Read.All Files.Read.All
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=
ATLASSIAN_CONNECTOR_SCOPES=read:jira-work read:jira-user read:confluence-content.all read:confluence-space.summary offline_access
